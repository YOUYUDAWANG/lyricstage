{
  "version": "lyric-gesture-grammar-v1",
  "scopes": ["glyph", "token", "phrase"],
  "drivers": ["lineEnter", "wordWindow", "lineHold", "lineExit", "structuralMoment"],
  "spaces": ["lyricLocal", "lyricToArtwork", "fullStage"],
  "semanticRoles": ["identity", "motion", "distance", "question", "repetition", "rupture", "resolution", "collective"],
  "primitives": [
    "glyph.weightPulse", "glyph.strokeTrace", "glyph.offsetSnap",
