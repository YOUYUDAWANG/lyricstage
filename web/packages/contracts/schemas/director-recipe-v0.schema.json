{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lyricstage.local/schemas/director-recipe-v0.schema.json",
  "title": "DirectorRecipeV0",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "recordingID", "lyricsHash", "recipes"],
  "properties": {
    "version": { "const": "director-recipe-v0" },
    "recordingID": { "type": "string", "minLength": 1, "maxLength": 160 },
    "lyricsHash": { "type": "string", "minLength": 1, "maxLength": 160 },
    "recipes": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lineIndex", "family", "intensity"],
        "properties": {
          "lineIndex": { "type": "integer", "minimum": 0 },
          "family": {
            "enum": [
              "fallback",
              "railHandoff",
              "semanticLens",
              "chorusMemory",
              "silenceAperture"
            ]
          },
          "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
          "motifPhase": {
            "enum": ["introduce", "develop", "transform", "resolve"]
          },
          "focusTokenFrom": { "type": "integer", "minimum": 0 },
          "focusTokenTo": { "type": "integer", "minimum": 0 },
          "companionLineIndices": {
            "type": "array",
            "maxItems": 3,
            "items": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
