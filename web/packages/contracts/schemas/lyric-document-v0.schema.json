{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lyricstage.local/schemas/lyric-document-v0.schema.json",
  "title": "LyricDocumentV0",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "recordingID", "durationMs", "lines"],
  "properties": {
    "version": { "const": "lyric-document-v0" },
    "recordingID": { "type": "string", "minLength": 1, "maxLength": 160 },
    "durationMs": { "type": "integer", "minimum": 1 },
    "language": { "type": "string", "maxLength": 40 },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lineIndex", "fromMs", "toMs", "text"],
        "properties": {
          "lineIndex": { "type": "integer", "minimum": 0 },
          "fromMs": { "type": "integer", "minimum": 0 },
          "toMs": { "type": "integer", "minimum": 1 },
          "text": { "type": "string", "minLength": 1 },
          "voiceRole": {
            "enum": ["lead", "harmony", "duetA", "duetB", "choir", "unknown"]
          },
          "layerID": { "type": "string", "maxLength": 80 },
          "overlapGroup": { "type": "string", "maxLength": 80 },
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["wordIndex", "fromMs", "toMs", "text"],
              "properties": {
                "wordIndex": { "type": "integer", "minimum": 0 },
                "fromMs": { "type": "integer", "minimum": 0 },
                "toMs": { "type": "integer", "minimum": 1 },
                "text": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
