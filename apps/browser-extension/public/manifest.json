{
  "manifest_version": 3,
  "name": "LyricStage for YouTube Music",
  "version": "0.4.7",
  "description": "让 LyricStage 歌词舞台在 YouTube Music 内跟随歌曲和播放时间。",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "activeTab", "tabCapture", "offscreen"],
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://lrclib.net/*",
    "https://sponsor.ajay.app/*",
    "http://mobilecdn.kugou.com/*",
    "http://krcs.kugou.com/*",
    "http://lyrics.kugou.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "LyricStage",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["content-ui-loader.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/content-ui.js", "assets/content-*.js"],
      "matches": ["https://music.youtube.com/*"]
    }
  ]
}
